{
  "manifest_version": 3,
  "name": "PDF Form Filler & Signer",
  "version": "1.0",
  "description": "Fill PDF forms, draw your signature, and add text — then download the result. No uploads, everything stays in your browser.",
  "permissions": ["storage"],
  "action": {
    "default_title": "PDF Form Filler & Signer — click to open",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer.html", "viewer.js", "viewer.css", "libs/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
